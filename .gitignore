# ─────────────────────────────────────────────
# بيانات جغرافية ثقيلة (تُولَّد بالـ pipeline ولا تُرفع)
# ─────────────────────────────────────────────
*.osm.pbf
*.osm
*.o5m
*.pmtiles
*.mbtiles
*.tif
*.tiff
*.jp2
geo-services/**/data/
geo-services/**/tiles-out/
geo-services/**/valhalla_tiles/
geo-services/**/photon_data/
geo-services/**/cache/
# Small hand-made fixtures are tracked (<=500KB, checked by tools/ownership). Never under a data/ dir.
!**/fixtures/**/*.osm
!**/fixtures/**/*.osm.pbf
!**/fixtures/**/*.pmtiles
!**/fixtures/**/*.tif

