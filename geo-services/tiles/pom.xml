<?xml version="1.0" encoding="UTF-8"?>
<!-- Planetiler profile for one city, OSM data only (no Natural Earth or ocean polygons). Layers and fields come from
     packages/contracts/schemas/tile-schema.json (TileSchema). Run through scripts/tiles.sh, see package.json. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>iq.iraqmaps</groupId>
  <artifactId>geo-tiles</artifactId>
  <version>0.0.0</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- The Planetiler distribution jar (planetiler-core plus GeoTools, which Maven Central lacks; its repository
         repo.osgeo.org is unreachable here). scripts/planetiler.sh fetches it, pinned by SHA-256 (ADR-0008). -->
    <dependency>
      <groupId>com.onthegomap.planetiler</groupId>
      <artifactId>planetiler</artifactId>
      <version>0.10.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/.cache/planetiler.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
    </plugins>
  </build>
</project>
