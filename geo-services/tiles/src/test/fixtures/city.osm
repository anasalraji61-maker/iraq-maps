<?xml version="1.0" encoding="UTF-8"?>
<!-- Original work, not derived from OpenStreetMap data. Dedicated to the public domain under CC0 1.0.
     Hand-made fixture for TilesTest: one element per TileSchema layer, plus elements the profile must drop
     (amenity=bench, the name:fr tag), a closed canal and a river that is also a district boundary.
     The test converts it to .osm.pbf with osmium. -->
<osm version="0.6" generator="hand">
  <node id="1" version="1" lat="33.310" lon="44.410">
    <tag k="place" v="suburb"/>
    <tag k="name" v="الكرادة"/>
    <tag k="name:ar" v="الكرادة"/>
    <tag k="name:ckb" v="کەڕادە"/>
    <tag k="name:en" v="Karrada"/>
    <tag k="name:fr" v="Karrada"/>
  </node>
  <node id="2" version="1" lat="33.305" lon="44.405">
    <tag k="amenity" v="restaurant"/>
    <tag k="name" v="مطعم الساعة"/>
  </node>
  <node id="3" version="1" lat="33.306" lon="44.406">
    <tag k="tourism" v="attraction"/>
    <tag k="historic" v="castle"/>
    <tag k="name" v="القلعة"/>
    <tag k="name:ar" v="القلعة"/>
    <tag k="name:en" v="Citadel"/>
  </node>
  <node id="4" version="1" lat="33.307" lon="44.407">
    <tag k="amenity" v="bench"/>
  </node>
  <!-- roads -->
  <node id="10" version="1" lat="33.300" lon="44.400"/>
  <node id="11" version="1" lat="33.310" lon="44.400"/>
  <node id="12" version="1" lat="33.320" lon="44.400"/>
  <!-- cafe building -->
  <node id="20" version="1" lat="33.312" lon="44.412"/>
  <node id="21" version="1" lat="33.312" lon="44.413"/>
  <node id="22" version="1" lat="33.313" lon="44.413"/>
  <node id="23" version="1" lat="33.313" lon="44.412"/>
  <!-- park -->
  <node id="30" version="1" lat="33.302" lon="44.402"/>
  <node id="31" version="1" lat="33.302" lon="44.404"/>
  <node id="32" version="1" lat="33.304" lon="44.404"/>
  <node id="33" version="1" lat="33.304" lon="44.402"/>
  <!-- river -->
  <node id="40" version="1" lat="33.300" lon="44.418"/>
  <node id="41" version="1" lat="33.320" lon="44.418"/>
  <!-- ring canal -->
  <node id="42" version="1" lat="33.322" lon="44.422"/>
  <node id="43" version="1" lat="33.322" lon="44.424"/>
  <node id="44" version="1" lat="33.324" lon="44.424"/>
  <!-- administrative boundary -->
  <node id="50" version="1" lat="33.300" lon="44.400"/>
  <node id="51" version="1" lat="33.300" lon="44.420"/>
  <node id="52" version="1" lat="33.320" lon="44.420"/>
  <node id="53" version="1" lat="33.320" lon="44.400"/>

  <way id="100" version="1">
    <nd ref="10"/><nd ref="11"/>
    <tag k="highway" v="primary"/>
    <tag k="name" v="شارع أبو نؤاس"/>
    <tag k="name:ar" v="شارع أبو نؤاس"/>
    <tag k="name:en" v="Abu Nuwas Street"/>
  </way>
  <way id="101" version="1">
    <nd ref="11"/><nd ref="12"/>
    <tag k="highway" v="residential"/>
  </way>
  <way id="200" version="1">
    <nd ref="20"/><nd ref="21"/><nd ref="22"/><nd ref="23"/><nd ref="20"/>
    <tag k="building" v="yes"/>
    <tag k="amenity" v="cafe"/>
    <tag k="name" v="مقهى الشابندر"/>
  </way>
  <way id="300" version="1">
    <nd ref="30"/><nd ref="31"/><nd ref="32"/><nd ref="33"/><nd ref="30"/>
    <tag k="leisure" v="park"/>
    <tag k="name" v="حديقة"/>
  </way>
  <way id="400" version="1">
    <nd ref="40"/><nd ref="41"/>
    <tag k="waterway" v="river"/>
    <tag k="name" v="دجلة"/>
    <tag k="name:en" v="Tigris"/>
  </way>
  <way id="401" version="1">
    <nd ref="42"/><nd ref="43"/><nd ref="44"/><nd ref="42"/>
    <tag k="waterway" v="canal"/>
    <tag k="name" v="قناة"/>
  </way>
  <way id="500" version="1">
    <nd ref="50"/><nd ref="51"/><nd ref="52"/><nd ref="53"/><nd ref="50"/>
  </way>

  <relation id="600" version="1">
    <member type="way" ref="500" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="4"/>
    <tag k="name" v="بغداد"/>
  </relation>
  <relation id="601" version="1">
    <member type="way" ref="400" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="6"/>
    <tag k="name" v="الرصافة"/>
  </relation>
</osm>
