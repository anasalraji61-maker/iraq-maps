{
  "$schema": "https://martin.maplibre.org/config-schema.json",
  "listen_addresses": ["0.0.0.0:3000"],
  "keep_alive": 75,
  "worker_processes": 0,

  "cache_size_mb": 512,

  "postgres": null,

  "pmtiles": {
    "sources": {
      "iraq": {
        "path": "../data/tiles/iraq.pmtiles",
        "tilejson": {
          "name": "Iraq Smart Maps",
          "description": "OpenStreetMap-based vector tiles for Iraq. Attribution: Map data © OpenStreetMap contributors (ODbL).",
          "attribution": "© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap contributors</a>",
          "bounds": [38.5, 29.0, 48.8, 37.5],
          "center": [44.4, 33.3, 10],
          "minzoom": 0,
          "maxzoom": 14
        }
      }
    }
  },

  "sprites": {},

  "fonts": {
    "paths": []
  }
}
