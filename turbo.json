{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_ADMIN_URL",
        "REDIS_URL",
        "APP_ENV",
        "OTP_SENDER",
        "OUTBOX_TARGET",
        "TRUST_PROXY",
        "PG*"
      ],
      "passThroughEnv": [
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "PHONE_ENCRYPTION_KEY",
        "PHONE_HASH_KEY",
        "OTP_FIXED_CODE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
