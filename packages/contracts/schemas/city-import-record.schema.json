{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "names": {
      "type": "object",
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "ckb": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "ar",
        "ckb",
        "en"
      ],
      "additionalProperties": false
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ]
    },
    "center": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ]
    }
  },
  "required": [
    "id",
    "names",
    "bbox",
    "center"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
