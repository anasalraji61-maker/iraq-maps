{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/fixtures/**"
  ],
  "ignoreWorkspaces": [
    "geo-services/pipeline",
    "geo-services/tiles"
  ],
  "ignoreBinaries": [
    "gitleaks"
  ],
  "includeEntryExports": true,
  "workspaces": {
    "modules/places": {
      // M1 freeze stub: integrator removes at M1 integration
      "ignoreDependencies": [
        "@iraq-maps/config",
        "@iraq-maps/contracts",
        "@iraq-maps/i18n",
        "@iraq-maps/observability",
        "@iraq-maps/testing",
        "@nestjs/core",
        "@nestjs/platform-fastify",
        "@ts-rest/nest",
        "drizzle-orm",
        "pmtiles",
        "tsx",
        "zod"
      ]
    },
    "packages/map-kit": {
      // M1 freeze stub: integrator removes at M1 integration
      "ignoreDependencies": [
        "@jest/globals",
        "@testing-library/react-native",
        "test-renderer"
      ]
    }
  }
}
