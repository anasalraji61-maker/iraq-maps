{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/fixtures/**"
  ],
  "ignoreWorkspaces": [
    "geo-services/pipeline"
  ],
  "ignoreBinaries": [
    "gitleaks"
  ],
  "includeEntryExports": true,
  "workspaces": {
    "apps/mobile": {
      "includeEntryExports": false
    },
    "mobile-features/*": {
      "includeEntryExports": false
    },
    "packages/ui": {
      "includeEntryExports": false
    },
    "packages/i18n": {
      "includeEntryExports": false
    },
    "packages/mobile-kit": {
      "includeEntryExports": false
    },
    "packages/api-client": {
      "includeEntryExports": false
    }
  }
}
