# انسخ هذا الملف إلى .env واملأ القيم محلياً. لا تضع أي قيمة حقيقية هنا — المستودع عام.
# Copy to .env and fill locally. NEVER commit real values.

# ── core ──
NODE_ENV=development
API_PORT=
DATABASE_URL=
REDIS_URL=

# ── identity ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PROVIDER=          # sms | whatsapp | console (dev only)
SMS_PROVIDER_API_KEY=

# ── messaging ──
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── assistant ──
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT_PER_USER=

# ── media / storage ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── geo services ──
VALHALLA_URL=
PHOTON_URL=
TILES_BASE_URL=

# ── notifications ──
FCM_SERVICE_ACCOUNT_JSON_PATH=   # path to a file outside the repo, never inline JSON

# ── mobile (PUBLIC — ships in the APK; never put secrets here) ──
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_TILES_URL=
