# انسخ هذا الملف إلى .env واملأ القيم محلياً. لا تضع أي قيمة حقيقية هنا — المستودع عام.
# Copy to .env and fill locally. NEVER commit real values.

# ── core ──
NODE_ENV=                      # leave unset; the tooling sets it. The server is configured by APP_ENV
APP_ENV=                       # required: development | test | e2e | production (`pnpm dev:api` defaults it to development)
API_PORT=
LOG_LEVEL=                     # debug | info | warn | error
DATABASE_URL=                  # app role (iraqmaps_app) — DML only, no DDL
REDIS_URL=
TEST_DATABASE_ADMIN_URL=       # tests only; falls back to DATABASE_URL
# Per-schema migration URLs (iraqmaps_migrate_<schema> login with <schema>_migrator role)
# Used by `drizzle-kit migrate` per module; leave empty to reuse DATABASE_URL (local dev only)
DB_MIGRATE_URL_IDENTITY=
DB_MIGRATE_URL_PROVIDERS=
DB_MIGRATE_URL_PLACES=
DB_MIGRATE_URL_MEDIA=
DB_MIGRATE_URL_MESSAGING=
DB_MIGRATE_URL_ASSISTANT=
DB_MIGRATE_URL_DISCOVER=
DB_MIGRATE_URL_ACTIVITY=
DB_MIGRATE_URL_NOTIFICATIONS=
TRUST_PROXY=                   # behind a proxy: the hop count or comma-separated proxy IPs/CIDRs; default false. `true` is refused in production (spoofable X-Forwarded-For)
ADMIN_KEY=                     # secret key for internal admin endpoints (X-Admin-Key header); leave empty to disable
REQUEST_SIGNING_SECRET=        # ≥32-char HMAC secret for mobile→API request signing (X-Request-Signature); leave empty to disable

# ── identity ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PHONE_ENCRYPTION_KEY=          # base64 32-byte AES-GCM key, generated locally / per CI run
PHONE_HASH_KEY=                # HMAC key for phone lookup hash
OTP_SENDER=                    # sms | console (development only) | fixed (e2e only) | fake (tests only)
OTP_FIXED_CODE=                # e2e only, used with OTP_SENDER=fixed
SMS_PROVIDER_API_KEY=

# ── messaging ──
MESSAGING_DAILY_LIMIT_PER_USER=   # max inquiries per user per day (default 10)
WHATSAPP_ACCESS_TOKEN=            # WhatsApp Cloud API access token (optional — fake used if absent)
WHATSAPP_PHONE_NUMBER_ID=         # WhatsApp sender phone number ID
WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # webhook verify token
WHATSAPP_APP_SECRET=              # used to validate inbound webhook signatures
WHATSAPP_TEMPLATE_NAME=           # message template name for structured sends

# ── assistant ──
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=                # Claude model for the assistant, e.g. claude-3-5-haiku-20241022
ASSISTANT_DAILY_LIMIT_PER_USER=

# ── media / storage ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── geo services ──
VALHALLA_URL=
PHOTON_URL=
TILES_SOURCE=                  # places fallback tile server (ADR-0008): absolute local path or https URL of the city PMTiles; {city} = city id
GLYPHS_SOURCE=                 # places fallback glyph server (ADR-0008): absolute directory path or https URL holding <fontstack>/<range>.pbf

# ── notifications ──
PUSH_PROVIDER=                    # fake | fcm (default: fake)
FCM_SERVICE_ACCOUNT_JSON_PATH=    # path to a file outside the repo, never inline JSON

# ── mobile (PUBLIC — ships in the APK; never put secrets here) ──
EXPO_PUBLIC_APP_ENV=           # development | e2e | production
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_TILES_URL=

# ── media module ──
# STORAGE_TYPE: file | s3 (default: file for dev/test)
STORAGE_TYPE=
MEDIA_SIGNING_SECRET=          # HMAC secret for FileObjectStorage signed URLs (dev/test only)
# MEDIA_MAX_BYTES: max upload size in bytes (default: 10485760 = 10 MiB)
MEDIA_MAX_BYTES=
S3_REGION=                     # S3/R2 region (default: auto for Cloudflare R2)

# ── Android release signing (GitHub Secrets — never put values here) ──
# Set these as GitHub repository secrets; build-apk.sh decodes KEYSTORE_BASE64 to a temp file.
KEYSTORE_BASE64=               # base64-encoded JKS/PKCS12 keystore: base64 -w0 < my-release-key.jks
KEYSTORE_ALIAS=                # key alias inside the keystore
KEYSTORE_PASSWORD=             # keystore password
KEY_PASSWORD=                  # key password (may equal KEYSTORE_PASSWORD)

# ── Admin panel (apps/admin Vite app) ──
VITE_API_URL=                  # backend URL for admin panel (default: http://localhost:3000)
VITE_ADMIN_KEY=                # x-admin-key value for /v1/admin/metrics endpoint

# ── Open Graph / sharing ──
OG_IMAGE_BASE_URL=             # base URL for OG image generation (e.g. https://iraqsmartmaps.app/og-images)
APP_BASE_URL=                  # public app base URL for deep link web fallbacks (e.g. https://iraqsmartmaps.app)
