# انسخ هذا الملف إلى .env واملأ القيم محلياً. لا تضع أي قيمة حقيقية هنا — المستودع عام.
# Copy to .env and fill locally. NEVER commit real values.

# ── core ──
NODE_ENV=                      # leave unset; the tooling sets it. The server is configured by APP_ENV
APP_ENV=                       # required: development | test | e2e | production (`pnpm dev:api` defaults it to development)
API_PORT=
LOG_LEVEL=                     # debug | info | warn | error
DATABASE_URL=
REDIS_URL=
TEST_DATABASE_ADMIN_URL=       # tests only; falls back to DATABASE_URL
TRUST_PROXY=                   # behind a proxy: the hop count or comma-separated proxy IPs/CIDRs; default false. `true` is refused in production (spoofable X-Forwarded-For)

# ── identity ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PHONE_ENCRYPTION_KEY=          # base64 32-byte AES-GCM key, generated locally / per CI run
PHONE_HASH_KEY=                # HMAC key for phone lookup hash
OTP_SENDER=                    # sms | console (development only) | fixed (e2e only) | fake (tests only)
OTP_FIXED_CODE=                # e2e only, used with OTP_SENDER=fixed
SMS_PROVIDER_API_KEY=

# ── messaging ──
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── assistant ──
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT_PER_USER=

# ── media / storage ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── geo services ──
VALHALLA_URL=
PHOTON_URL=
TILES_BASE_URL=
TILES_SOURCE=                  # places fallback tile server (ADR-0008): local path or https URL of the city PMTiles; {city} = city id
GLYPHS_SOURCE=                 # places fallback glyph server (ADR-0008): directory or https URL holding <fontstack>/<range>.pbf

# ── notifications ──
FCM_SERVICE_ACCOUNT_JSON_PATH=   # path to a file outside the repo, never inline JSON

# ── mobile (PUBLIC — ships in the APK; never put secrets here) ──
EXPO_PUBLIC_APP_ENV=           # development | e2e | production
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_TILES_URL=
